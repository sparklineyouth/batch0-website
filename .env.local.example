# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — do NOT commit secrets.

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Service role: bypasses RLS, server-side ONLY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ------------------------------------------------------------
# Stripe
# Use test keys (sk_test_..., pk_test_...) while developing.
# Switch to live keys for production.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen` (local) or your dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ------------------------------------------------------------
# Discord
# All optional — every helper no-ops when unset, so the app runs
# fine without them. Channel and role IDs are NOT env vars: they
# live in the site_settings table and are edited at /admin/discord.
#
# From https://discord.com/developers/applications → your app:
#   Bot → Reset Token
# ------------------------------------------------------------
DISCORD_BOT_TOKEN=
# General Information → Application ID (also the OAuth client id)
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret. Needed for account linking.
DISCORD_CLIENT_SECRET=
# General Information → Public Key. Verifies slash-command signatures;
# without it /api/discord/interactions rejects everything with 401.
DISCORD_PUBLIC_KEY=
# Right-click your server → Copy Server ID (needs Developer Mode on).
DISCORD_GUILD_ID=
#
# Legacy fallbacks. Prefer configuring these at /admin/discord instead —
# the site_settings values take precedence and the UI validates them.
# DISCORD_ANNOUNCEMENTS_WEBHOOK is only used when no announcements
# channel is configured.
DISCORD_ANNOUNCEMENTS_WEBHOOK=
DISCORD_ROLE_STUDENT=
#
# Local OAuth setup: add http://localhost:3000/auth/discord/callback to
# OAuth2 → Redirects. The redirect_uri is derived from the request origin,
# so every origin you browse from (apex, www, localhost, and any Vercel
# preview URL) must be listed there or the code exchange fails.

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Founder passes
# ------------------------------------------------------------
# HMAC key for founder-pass codes. Required to mint printed cards
# (/admin/passes, scripts/mint-cards.mts) and to issue virtual passes; the
# database stores only HMAC(code, pepper), never a code, so this key is the
# only thing that makes a stored hash mean anything.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# TREAT IT AS A SIGNING KEY, NOT A CONFIG KNOB. It must be byte-identical in
# .env.local and in every Vercel environment that redeems passes, and once a
# single pass exists it can NEVER change: every code ever issued hashes to a
# value only the current pepper reproduces, so rotating it silently bricks
# every printed card in someone's wallet and every virtual pass sitting in an
# inbox. There is no migration path — the plaintext codes are not stored, so
# they cannot be re-hashed under a new key.
FOUNDER_PASS_PEPPER=
