# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — do NOT commit secrets.

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Service role: bypasses RLS, server-side ONLY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ------------------------------------------------------------
# Stripe
# Use test keys (sk_test_..., pk_test_...) while developing.
# Switch to live keys for production.
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen` (local) or your dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ------------------------------------------------------------
# Discord
# All optional — every helper no-ops when unset, so the app runs
# fine without them. Channel and role IDs are NOT env vars: they
# live in the site_settings table and are edited at /admin/discord.
#
# From https://discord.com/developers/applications → your app:
#   Bot → Reset Token
# ------------------------------------------------------------
DISCORD_BOT_TOKEN=
# General Information → Application ID (also the OAuth client id)
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret. Needed for account linking.
DISCORD_CLIENT_SECRET=
# General Information → Public Key. Verifies slash-command signatures;
# without it /api/discord/interactions rejects everything with 401.
DISCORD_PUBLIC_KEY=
# Right-click your server → Copy Server ID (needs Developer Mode on).
DISCORD_GUILD_ID=
#
# Legacy fallbacks. Prefer configuring these at /admin/discord instead —
# the site_settings values take precedence and the UI validates them.
# DISCORD_ANNOUNCEMENTS_WEBHOOK is only used when no announcements
# channel is configured.
DISCORD_ANNOUNCEMENTS_WEBHOOK=
DISCORD_ROLE_STUDENT=
#
# Local OAuth setup: add http://localhost:3000/auth/discord/callback to
# OAuth2 → Redirects. The redirect_uri is derived from the request origin,
# so every origin you browse from (apex, www, localhost, and any Vercel
# preview URL) must be listed there or the code exchange fails.

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# Founder passes
# ------------------------------------------------------------
# HMAC key for founder-pass codes. Required to mint printed cards
# (/admin/passes, scripts/mint-cards.mts) and to issue virtual passes; the
# database stores only HMAC(code, pepper), never a code, so this key is the
# only thing that makes a stored hash mean anything.
#
# Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
#
# TREAT IT AS A SIGNING KEY, NOT A CONFIG KNOB. It must be byte-identical in
# .env.local and in every Vercel environment that redeems passes, and once a
# single pass exists it can NEVER change: every code ever issued hashes to a
# value only the current pepper reproduces, so rotating it silently bricks
# every printed card in someone's wallet and every virtual pass sitting in an
# inbox. There is no migration path — the plaintext codes are not stored, so
# they cannot be re-hashed under a new key.
FOUNDER_PASS_PEPPER=

# ------------------------------------------------------------
# Search-engine verification (SEO)
# Optional. Paste the token each console gives you to prove domain
# ownership; the matching <meta> tag renders from app/layout.tsx.
# Set these in Vercel (Production) and redeploy — they're read at build.
# Leave blank to render nothing.
#
#   Google Search Console → Add property → "HTML tag" method → copy the
#   content="..." value (NOT the whole tag).
#   https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
#   Bing Webmaster Tools → Add site → "Meta tag" → copy the content value.
#   (Or import directly from Google Search Console — one click, no token.)
#   https://www.bing.com/webmasters
BING_SITE_VERIFICATION=

# ------------------------------------------------------------
# Daily — live video (webinars + 1:1 calls)
# Optional. Every helper no-ops when unset, so the site runs fine
# without these; hosted webinars and 1:1 calls simply report
# "hosting unavailable" until they're filled in.
#
#   Daily dashboard → Developers → API key
#   https://dashboard.daily.co/developers
# ------------------------------------------------------------
# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_ — it can create rooms
# and mint OWNER tokens for any room on the domain, so exposing it to the
# browser hands every visitor host rights to every call the site hosts,
# including 1:1s the token was never issued for. Treat it like
# SUPABASE_SERVICE_ROLE_KEY: server code only, never imported into a
# "use client" module.
DAILY_API_KEY=
# Your Daily subdomain, e.g. batch0.daily.co (no https://, no trailing
# slash). Public by design — it appears in every room URL the browser
# connects to. It grants nothing on its own: rooms are created private,
# so joining one requires a token minted server-side after the usual
# permission checks.
NEXT_PUBLIC_DAILY_DOMAIN=
# Cloud recording of webinars. Leave unset on Daily's free plan — it
# rejects room/token creation outright if recording is requested, which
# would make hosted webinars fail to start. Set to "true" only once the
# Daily account is on a plan that includes cloud recording; then hosts
# can record and the webhook can populate events.recording_url.
DAILY_ENABLE_RECORDING=
# Large-call optimization for webinars (experimental_optimize_large_calls).
# Only needed above 50 participants, and like recording it is a PAID Daily
# feature: an account with no payment method rejects the room with "account
# is missing a payment method", so leaving this OFF is what lets webinars
# work on a free/card-less account. Set to "true" only when the account has
# a card AND a webinar genuinely expects 50+ viewers.
DAILY_LARGE_CALLS=

# ------------------------------------------------------------
# batch0 Live — the built-in webinar/call provider (the default)
# See docs/batch0-live.md
# ------------------------------------------------------------
# NOTHING HERE IS REQUIRED. Webinars and 1:1 calls run out of the
# box: signalling rides Supabase Realtime (already configured
# above) and media goes browser-to-browser over WebRTC, so there
# is no vendor, no account, and no key to obtain.
#
# Which provider live video runs on: "builtin" (default) or
# "daily". It defaults to builtin because the Daily account this
# project was wired to cannot start a media session at all —
# every join is refused with account-missing-payment-method,
# which is an account-level block no code here can clear. Set
# this to "daily" only after adding a card to that account, and
# verify with `npm run webinar-e2e -- --provider=daily` rather
# than `npm run daily-doctor` (the REST plane passes even when
# the media plane is dead — that is how this went unnoticed).
LIVE_PROVIDER=
# Secret that Realtime channel names and host proofs are derived
# from. Optional: falls back to SUPABASE_SERVICE_ROLE_KEY, which
# is a one-way HMAC input and is never transmitted — only
# truncated HMACs of it reach a browser, each scoped to a single
# channel. Set this to rotate every room key without touching
# Supabase credentials.
LIVE_ROOM_SECRET=
# Optional TURN relay, for viewers whose network refuses a direct
# peer connection (symmetric NAT, strict school/corporate
# firewalls). STUN alone covers most home networks, so leaving
# this unset means "no relay", not "broken" — a small number of
# viewers will see "couldn't connect". Comma-separated URLs.
# Server-only: credentials are handed to the browser per join,
# never inlined into the bundle.
LIVE_TURN_URLS=
LIVE_TURN_USERNAME=
LIVE_TURN_CREDENTIAL=
